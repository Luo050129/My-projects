# 知渡（ZhiDu）环境变量样板
# 用法：复制为本机 .env 或按部署平台注入进程环境变量；本文件不含任何真实密钥。
# 合集根 .gitignore 已忽略 .env / *.env，真实配置不会入库。

# ---- 必填：prod 启动前必须注入，local/test 有演示默认值 ----
# HS256 要求至少 32 字节随机串，可用 `openssl rand -hex 32` 生成。
# 未注入或长度不足时应用会在启动期 fail-fast 并给出提示，不会静默使用弱密钥。
JWT_SECRET=

# ---- prod 数据库（表结构由 Flyway 自动迁移，见 src/main/resources/db/migration/）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- RabbitMQ（community.mq.type=rabbitmq 时生效）----
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---- 跨源白名单：prod 必须显式配置，多个用逗号分隔，不再允许 "*" ----
# 例如 https://zhidu.example.com,https://admin.zhidu.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- AI：留空即走规则降级，主链路不受影响 ----
DEEPSEEK_API_KEY=

# ---- 文件存储 ----
UPLOAD_DIR=./data/uploads
